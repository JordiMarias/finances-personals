# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly declare text files you always want to be normalized and not converted to CRLF on checkout
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Declare files that are always binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.wasm binary
*.ods binary
*.pdf binary
*.zip binary
*.tar.gz binary
